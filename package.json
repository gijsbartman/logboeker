{
  "name": "logboeker",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "test": "turbo run test",
    "check-types": "turbo run check-types",
    "test:projects": "vitest run",
    "test:projects:watch": "vitest --watch"
  },
  "devDependencies": {
    "@repo/vitest-config": "workspace:*",
    "eslint": "10.9.1",
    "prettier": "3.9.6",
    "turbo": "^2.11.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24.20.0"
  },
  "packageManager": "pnpm@11.24.0"
}
